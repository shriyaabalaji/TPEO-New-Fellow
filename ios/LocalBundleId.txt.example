# Copy to LocalBundleId.txt (gitignored). First non-comment line = iOS bundle ID.
#
# Default below matches Firebase app "tpeo_new_fellow (ios)" with bundle ID
# com.example.tpeoNewFellow — same as ios/Runner/GoogleService-Info.plist and
# lib/firebase_options.dart. Use this unless you switch Firebase apps.
#
# To use a different Firebase iOS registration (e.g. com.tpeo.tpeoNewFellow):
#   1) Download that app's GoogleService-Info.plist from Firebase Console.
#   2) Replace ios/Runner/ and macos/Runner/ plists; run:
#        dart pub global activate flutterfire_cli
#        flutterfire configure
#   3) Put that bundle ID on the line below and run:
#        ./scripts/apply_local_bundle_id.sh
#
# In Xcode → Signing & Capabilities, pick your Team (Personal Team is fine).
# DEVELOPMENT_TEAM is not committed so each developer uses their own Apple ID.

com.example.tpeoNewFellow
